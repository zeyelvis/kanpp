{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanpp",
  // worker.ts serves /img/* itself and hands everything else to the OpenNext build.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the real domains serve the site: a *.workers.dev copy would be duplicate content.
  "workers_dev": false,
  "preview_urls": false,
  // D1 and R2 are in APAC while Googlebot crawls from US colos, where a cold page's several
  // D1/R2 round trips each cross the Pacific (p50 0.4-2.6 s vs ~0.1 s in Asia, Sep 2026).
  // Smart Placement runs such requests next to the data instead.
  "placement": { "mode": "smart" },
  "routes": [
    { "pattern": "kanpp.tv", "custom_domain": true },
    { "pattern": "www.kanpp.tv", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kanpp"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanpp-db",
      "database_id": "1142d043-d0ee-4d0d-9574-9a980f44568a",
      "migrations_dir": "migrations"
    },
    // OpenNext tag cache (revalidateTag/Path timestamps). Kept apart from the catalog.
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "kanpp-next-tags",
      "database_id": "dc68b291-279b-49b2-810b-f26094137632"
    }
  ],
  // OpenNext incremental cache: ISR pages and unstable_cache entries.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "kanpp-next-cache"
    },
    // Same-origin copies of TMDB images (lib/edge/image-proxy.ts).
    {
      "binding": "IMAGES",
      "bucket_name": "kanpp-images"
    }
  ],
  // OpenNext queue for time-based (ISR) revalidation.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // First-party page view counts (lib/edge/pageview.ts): no IP, no identifier.
  "analytics_engine_datasets": [{ "binding": "PAGEVIEWS", "dataset": "kanpp_pageviews" }],
  // Per-visitor API limits (lib/edge/rate-limit.ts). namespace_id: any number unique in the account.
  "ratelimits": [
    { "name": "RL_BEACON", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "4202", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
