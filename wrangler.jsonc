{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanpp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the real domains serve the site: a *.workers.dev copy would be duplicate content.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kanpp.tv", "custom_domain": true },
    { "pattern": "www.kanpp.tv", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kanpp"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanpp-db",
      "database_id": "1142d043-d0ee-4d0d-9574-9a980f44568a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
